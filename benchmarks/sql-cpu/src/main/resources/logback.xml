<?xml version="1.0" encoding="UTF-8"?>
<!--
  ベンチのログ。置かないと logback の既定（DEBUG をコンソール）になり、
  MariaDB のドライバが 1 回ごとに SQL 全文を出して、その書き出しを測ってしまう。
  アプリの本番と同じく INFO にする
-->
<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>
	<root level="INFO">
		<appender-ref ref="STDOUT"/>
	</root>
</configuration>
