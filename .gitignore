# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# 疎通確認（使い捨て）
/probe/

# 作業用のアーカイブ・スナップショット（公開しない）
*.tgz
*.tar.gz
*.zip
!gradle/wrapper/*.zip
/build-tmp/

# 開発中に出るもの
/dump.rdb
*.log

# 秘密（万一置いても入らないように）
*.gpg
*.asc
*.p12
*.jks
secring.*
.env
.env.*
application.local.conf

# 設計メモと要件（公開しない）
#
# jooby_base（社内フレームワーク）の棚卸しと精読結果を含むため外している。
# 出すものだけ ! で戻す。
#
# 先頭の / が要る。付けないと「どの階層の docs/ も」という意味になり、
# jimble-docs/src/main/jte/docs/ まで巻き込む（テンプレートが消える）。
#
# /docs/ ではなく /docs/* と書くこと。ディレクトリごと外すと、
# その中のものは ! で戻せない（git の決まり）。
# /docs/ と書いて !/docs/site/ を足しても、原稿は入らない。
/docs/*

# ドキュメントサイトの原稿は公開する。
# CI がこれを読んでサイトを作り、jimble.io へ反映する（要件 NF-D-01 / D-117）。
# 入っていないと 0 ページのサイトができあがる（site タスクは成功してしまう）
!/docs/site/
/docs/site/build/

# 公開 API と内部実装の線引き（要件 NF-C-03 / NF-C-04）。
# ApiSurfaceTest がこれを読むので、入っていないと CI で落ちる。
# versioning.md が GitHub 上のこのファイルを指してもいる
!/docs/api-packages.txt


# claude
/Claude outputs/